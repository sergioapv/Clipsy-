# Copy to `.env` and fill in. Used with: flutter run --dart-define-from-file=.env
# Find these in Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable ("anon") key. Safe to ship in the app; RLS protects the data.
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Optional: link opened from Settings → Privacy policy.
PRIVACY_POLICY_URL=https://example.com/clipsy/privacy
